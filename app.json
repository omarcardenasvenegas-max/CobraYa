{
  "expo": {
    "name": "CobroYa",
    "slug": "cobroya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bo.cobroya.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bo.cobroya.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "CobroYa usa tus fotos para guardar tu QR de cobro y los comprobantes de pago.",
          "cameraPermission": "CobroYa usa la cámara para fotografiar comprobantes de pago."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "scheme": "cobroya",
    "experiments": {
      "typedRoutes": false
    }
  }
}
